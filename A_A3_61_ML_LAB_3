import pandas as pd
import numpy as np

# Load dataset
df = pd.read_csv("enjoy.csv")

# Separate features and target
X = df.iloc[:, :-1].values
y = df.iloc[:, -1].values


def candidate_elimination(concepts, target):

    # Initialize specific hypothesis
    specific = concepts[0].copy()

    # Initialize general hypothesis
    general = [["?" for _ in range(len(specific))]]

    print("\nInitial S:", specific)
    print("Initial G:", general)

    for i, h in enumerate(concepts):

        # Positive example
        if target[i] == "Yes":
            for x in range(len(specific)):
                if h[x] != specific[x]:
                    specific[x] = "?"

        # Negative example
        else:
            for x in range(len(specific)):
                if h[x] != specific[x]:
                    hypothesis = [
                        "?" if j != x else specific[x]
                        for j in range(len(specific))
                    ]

                    if hypothesis not in general:
                        general.append(hypothesis)

        print("\nExample", i + 1)
        print("S =", specific)
        print("G =", general)

    return specific, general


# Run Candidate Elimination
S, G = candidate_elimination(X, y)

print("\nFinal Specific Boundary")
print(S)

print("\nFinal General Boundary")
for g in G:
    print(g)
